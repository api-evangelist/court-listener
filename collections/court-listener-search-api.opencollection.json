{
  "opencollection": "1.0.0",
  "info": {
    "name": "CourtListener REST Alerts Search API",
    "version": "4.4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Runs advanced search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.courtlistener.com/api/rest/v4/search/",
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "response format for calls (XML,JSON,JSONP)"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "common delimited fields for return fields"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "which field to order results by"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "number of records to limit response listing by (1000 max)"
              },
              {
                "name": "absolute_url",
                "value": "",
                "type": "query",
                "description": "pull the detail for an opinion"
              }
            ]
          },
          "docs": "Provides an advanced search via solr"
        },
        {
          "info": {
            "name": "List Search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.courtlistener.com/api/rest/v4/api/rest/v4/search/",
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (json, xml, html)"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to order results by"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response"
              }
            ]
          },
          "docs": "Full-text search across opinions, dockets, and oral arguments"
        },
        {
          "info": {
            "name": "Retrieve Search",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.courtlistener.com/api/rest/v4/api/rest/v4/search/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the search"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format (json, xml, html)"
              }
            ]
          },
          "docs": "Retrieve a single search by ID"
        }
      ]
    }
  ],
  "bundled": true
}